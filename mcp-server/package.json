{
  "name": "@whitenoisenpm/testforge-mcp",
  "version": "0.9.0",
  "description": "TestForge MCP Server — AI-powered testing in your IDE. Analyzes code for security, unit tests, load, accessibility, vision alignment, scope coverage, and stack quality.",
  "type": "module",
  "bin": {
    "testforge-mcp": "./bin.js"
  },
  "main": "./bin.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "public",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "testing",
    "mcp",
    "model-context-protocol",
    "security",
    "code-analysis",
    "ai",
    "cursor",
    "vscode",
    "testforge",
    "static-analysis",
    "vision-alignment",
    "scope-testing",
    "stack-analysis"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/t4tarzan/testforge",
    "directory": "mcp-server"
  },
  "homepage": "https://testforge.run",
  "license": "MIT",
  "dependencies": {
    "@babel/parser": "^7.29.7",
    "@babel/traverse": "^7.29.7",
    "@babel/types": "^7.29.7",
    "@fastify/cors": "^9.0.0",
    "@fastify/static": "^7.0.4",
    "better-sqlite3": "^12.10.0",
    "chalk": "^5.3.0",
    "dotenv": "^16.4.0",
    "fast-json-stringify": "^5.16.1",
    "fastify": "^4.28.0",
    "glob": "^10.4.0",
    "js-yaml": "^4.1.1"
  },
  "devDependencies": {
    "@types/babel__traverse": "^7.28.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.0.0",
    "tsx": "^4.15.0",
    "typescript": "^5.4.0",
    "vitest": "^4.1.7"
  },
  "engines": {
    "node": ">=18"
  }
}
