# TestForge — Environment Configuration
# Copy to .env and fill in for local dev. In production these live in
# Vercel project env (Settings → Environment Variables).

# ─── Database ─────────────────────────────────────────────────────────
# Neon PostgreSQL connection string. https://neon.tech
DATABASE_URL=postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/testforge?sslmode=require

# ─── Session (auth) ───────────────────────────────────────────────────
# Used to sign the tf_session JWT cookie. Must be ≥32 random chars.
# Generate one:  openssl rand -base64 48
SESSION_SECRET=replace-me-with-at-least-32-random-bytes-please

# ─── GitHub OAuth ─────────────────────────────────────────────────────
# Create an OAuth app at https://github.com/settings/developers
# Authorization callback URL: https://testforge.run/api/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ─── Stripe ───────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTERPRISE=

# ─── MCP server (Fly.io) ──────────────────────────────────────────────
# URL of the analyzer service. Used by /api/analyze to clone & inspect repos.
MCP_SERVER_URL=https://testforge-mcp.fly.dev

# ─── Rate limiter (B4 — once Upstash is provisioned) ──────────────────
# Provision via Vercel Marketplace → Upstash Redis (free tier is enough).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
